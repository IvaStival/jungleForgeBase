# jungleforgebase control-plane config. Copy to .env and edit.
#
#  - Project registry: one <PROJECT>_PATH per project (absolute path to the repo root).
#    `make up your-app` looks up YOUR_APP_PATH (name uppercased, dashes -> underscores).
#    Each project's host port (APP_HTTP_PORT) lives in its own deploy/.docker-env — give each
#    a DISTINCT port so they don't collide on the host.
#  - All projects share the external lion-network and reach EACH OTHER at http://<project>:8080
#    (the in-container nginx port — independent of the host port above).
#  - Shared services: credentials/ports for docker-compose.services.yml (one set for all
#    projects). Each project's own .env must point DB_HOST=postgres, REDIS_HOST=redis,
#    RABBITMQ_HOST=rabbitmq and use a database/credentials that exist in the shared postgres.

# ---- Project registry (absolute paths) ----
EXAMPLE_APP_PATH=/absolute/path/to/your-app
# Uncomment to try the included runnable demo (see Quickstart in README.md):
# DEMO_API_PATH=/absolute/path/to/jungleforgebase/examples/demo-api

# ---- Cross-arch image registry (multi-arch push/pull) ----
# Leave REGISTRY empty for local-only builds; set it (e.g. docker.io/youruser,
# ghcr.io/youruser) to publish multi-arch images and pull them from other hosts.
REGISTRY=
TARGET_PLATFORMS=linux/amd64,linux/arm64,linux/arm/v7

# ---- Shared services (docker-compose.services.yml) ----
# SERVICES_PREFIX=myinstance-   # uncomment + change (include the trailing separator) if running
                                 # >1 instance of this control plane on the same host, to avoid
                                 # container/project name clashes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=postgres
POSTGRES_PORT=5432

REDIS_PASSWORD=change_me
REDIS_PORT=6379

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
