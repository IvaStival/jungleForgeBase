# Copy to your project root as .dockerignore. Keeps the prod build context small and keeps
# secrets / host-built artifacts out of the baked image.

.git
.gitignore
.github

# Host-installed deps — the image rebuilds these in the vendor stage.
vendor

# Secrets — the prod container bind-mounts .env at runtime instead.
.env
.env.*
!.env.example

# Local/dev cruft
var/cache/*
var/log/*
tests
phpunit.xml*
*.md
.editorconfig
.DS_Store
